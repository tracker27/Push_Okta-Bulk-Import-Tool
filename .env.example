# Okta domain (Org Authorization Server is used, e.g. https://your-org.okta.com)
OKTA_DOMAIN=https://your-domain.okta.com

# --- This tool's own login gate (required) ---
# Protects every endpoint that can read/write Okta data - without this, anyone
# who can reach the backend port could create Okta users or manage groups with
# no credentials at all. Pick your own values; share only with people who
# should be able to provision users. The backend refuses to start without these.
APP_USERNAME=changeme
APP_PASSWORD=change-this-to-a-long-random-value

# --- OAuth Service App (recommended, proven working) ---
# Create a Service app (OAuth 2.0 client credentials) in Okta, grant it the
# Okta API Scopes below under the app's "Okta API Scopes" tab, and assign it
# admin roles (User Administrator, Group Administrator).
OKTA_CLIENT_ID=your_service_app_client_id
OKTA_PRIVATE_KEY={"kty": "RSA", "use": "sig", "kid": "...", "n": "...", "e": "AQAB", "d": "...", "p": "...", "q": "...", "dp": "...", "dq": "...", "qi": "..."}
# Required granted scopes: okta.users.manage okta.users.read okta.groups.manage okta.groups.read

# --- Alternative: personal API token (fallback, only used if the above is not set) ---
# OKTA_API_TOKEN=your_api_token_here
